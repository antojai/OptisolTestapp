# =============================================================================
# Environment Configuration Template for TestApplication
# =============================================================================
# Copy this file to .env and fill in the actual values for your environment.
# This file serves as a template and should be committed to version control.
# The actual .env file should NOT be committed as it contains sensitive data.

# =============================================================================
# API Configuration
# =============================================================================

# Base URL for the API server
API_BASE_URL=http://your-api-server.com/alertmobile/

# API Authorization Bearer Token (replace with your actual token)
API_BEARER_TOKEN=your-bearer-token-here

# API Timeout settings (in seconds)
API_CONNECT_TIMEOUT=30
API_READ_TIMEOUT=30
API_WRITE_TIMEOUT=30

# =============================================================================
# Application Configuration
# =============================================================================

# Default user ID for testing/development
DEFAULT_USER_ID=123

# Default location coordinates
DEFAULT_LATITUDE=0.0
DEFAULT_LONGITUDE=0.0

# Application environment (development, staging, production)
APP_ENVIRONMENT=development

# Enable/disable debug logging
DEBUG_ENABLED=true

# =============================================================================
# Build Configuration
# =============================================================================

# Application ID (package name)
APPLICATION_ID=com.greenstark.org.testapplication

# Version information
VERSION_CODE=1
VERSION_NAME=1.0

# Target SDK versions
COMPILE_SDK_VERSION=27
MIN_SDK_VERSION=21
TARGET_SDK_VERSION=27

# =============================================================================
# Security Configuration
# =============================================================================

# Enable/disable certificate pinning
CERTIFICATE_PINNING_ENABLED=false

# Enable/disable network security config
NETWORK_SECURITY_CONFIG_ENABLED=true

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/disable specific features
FEATURE_ANALYTICS_ENABLED=false
FEATURE_CRASH_REPORTING_ENABLED=false
FEATURE_LOCATION_TRACKING_ENABLED=true

# =============================================================================
# Third-party Service Configuration
# =============================================================================

# Google Services
GOOGLE_SERVICES_ENABLED=false
GOOGLE_API_KEY=your-google-api-key

# Firebase configuration
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=your-firebase-app-id

# Analytics configuration
ANALYTICS_ENABLED=false
ANALYTICS_TRACKING_ID=your-analytics-tracking-id

# =============================================================================
# Development Configuration
# =============================================================================

# Enable/disable development tools
DEVELOPMENT_TOOLS_ENABLED=true

# Mock data for testing
USE_MOCK_DATA=false

# Network interceptor for debugging
NETWORK_LOGGING_ENABLED=true

# =============================================================================
# Performance Configuration
# =============================================================================

# Memory settings
HEAP_SIZE=1536m

# Network configuration
MAX_CONCURRENT_REQUESTS=5
CACHE_SIZE_MB=50

# =============================================================================
# Localization
# =============================================================================

# Default language and region
DEFAULT_LANGUAGE=en
DEFAULT_REGION=US

# =============================================================================
# Notification Configuration
# =============================================================================

# Push notification settings
PUSH_NOTIFICATIONS_ENABLED=false
FCM_SENDER_ID=your-fcm-sender-id

# =============================================================================
# Database Configuration
# =============================================================================

# Local database settings
DATABASE_NAME=testapp.db
DATABASE_VERSION=1

# =============================================================================
# Testing Configuration
# =============================================================================

# Test environment settings
TEST_API_BASE_URL=http://test.api.example.com/
TEST_USER_ID=999
TEST_BEARER_TOKEN=test-token-123

# =============================================================================
# Deployment Configuration
# =============================================================================

# Keystore information (for release builds)
KEYSTORE_FILE=path/to/your/keystore.jks
KEYSTORE_PASSWORD=your-keystore-password
KEY_ALIAS=your-key-alias
KEY_PASSWORD=your-key-password

# ProGuard settings
PROGUARD_ENABLED=false
PROGUARD_CONFIG_FILE=proguard-rules.pro
