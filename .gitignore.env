# Environment Configuration Files
# Add these lines to your main .gitignore file

# Environment files with sensitive data - DO NOT COMMIT
.env
.env.local
.env.*.local

# Keep template and environment-specific files - SAFE TO COMMIT
!.env.example
!.env.development
!.env.staging
!.env.production

# Backup environment files
.env.backup
.env.bak
*.env.backup
*.env.bak

# IDE-specific environment files
.env.idea
.env.vscode
.env.eclipse

# OS-specific environment files
.env.windows
.env.mac
.env.linux

# Temporary environment files
.env.tmp
.env.temp
*.env.tmp
*.env.temp
